{
  "name": "modemon-go-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@turf/boolean-point-in-polygon": "7.3.4",
    "expo": "58.0.14",
    "expo-constants": "58.0.12",
    "expo-dev-client": "58.0.14",
    "expo-linking": "58.0.13",
    "expo-location": "58.0.17",
    "expo-router": "58.0.23",
    "expo-status-bar": "58.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.59.0",
    "lucide-react-native": "1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "play:web": "vite web --host 127.0.0.1",
    "build:playable": "npm run validate:quizzes && vite build web && node --experimental-strip-types web/scripts/check-payload.ts",
    "validate:quizzes": "node --experimental-strip-types web/scripts/validate-quizzes.ts",
    "check:playable": "tsc -p web/tsconfig.json && eslint web/src web/tests web/scripts web/vite.config.ts web/playwright.config.ts",
    "test:playable": "node --experimental-strip-types --test web/tests/*.test.ts",
    "test:playable:e2e": "playwright test --config web/playwright.config.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
